# =============================================================================
# Contoh environment variables. Salin menjadi .env.local (lokal) atau isi di
# dasbor hosting (produksi). JANGAN commit nilai sungguhan.
# Variabel berawalan NEXT_PUBLIC_ terlihat di browser: jangan isi rahasia.
# =============================================================================

# --- Situs ---------------------------------------------------------------------
# URL kanonik situs, tanpa garis miring di akhir. Dipakai untuk redirect OAuth
# dan tautan email. Lokal: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SCHOOL_NAME="SMA Negeri 3 Takalar"
NEXT_PUBLIC_SCHOOL_SHORT_NAME="SMAN 3 Takalar"
# URL https logo resmi (opsional; isi hanya bila sekolah mengizinkan).
NEXT_PUBLIC_SCHOOL_LOGO_URL=
# Kontak resmi di footer (opsional). Kosongkan bila belum ada data resmi.
NEXT_PUBLIC_SCHOOL_ADDRESS=
NEXT_PUBLIC_SCHOOL_PHONE=
NEXT_PUBLIC_SCHOOL_EMAIL=

# --- Supabase (Project Settings > API) -----------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://GANTI-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=GANTI_DENGAN_ANON_KEY
# RAHASIA. Melewati RLS. Hanya di server, jangan pernah NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=GANTI_DENGAN_SERVICE_ROLE_KEY

# Google OAuth TIDAK dikonfigurasi di sini: Client ID & Client Secret Google
# diisi di dasbor Supabase (Authentication > Providers > Google).
# Lihat docs/google-oauth.md.

# --- Langganan berita ----------------------------------------------------------
# Rahasia acak >= 32 karakter untuk token berhenti berlangganan & hash rate
# limit. Buat dengan: openssl rand -base64 48
# Mengganti nilai ini membatalkan semua tautan berhenti berlangganan lama.
NEWSLETTER_TOKEN_SECRET=GANTI_DENGAN_STRING_ACAK_MINIMAL_32_KARAKTER

# Penyedia email: "resend" (produksi) atau "console" (hanya pengembangan
# lokal; email dicetak di log, tidak dikirim). Kosong = langganan nonaktif.
EMAIL_PROVIDER=
RESEND_API_KEY=
# Alamat pengirim pada domain yang sudah diverifikasi di Resend.
EMAIL_FROM="Berita Sekolah <berita@domain-sekolah-anda.sch.id>"
EMAIL_REPLY_TO=
# Signing secret webhook Resend (diawali whsec_).
RESEND_WEBHOOK_SECRET=

# Pengiriman bertahap: jeda antar email (ms) & jumlah email per gelombang.
NEWSLETTER_SEND_DELAY_MS=600
NEWSLETTER_BATCH_SIZE=25

# Rahasia untuk endpoint /api/cron/newsletter (Vercel Cron mengirimnya
# otomatis sebagai Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=GANTI_DENGAN_STRING_ACAK
